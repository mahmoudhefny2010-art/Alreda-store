<section class="admin-management admin-offers-page">
  <header class="admin-page-heading"><div><span class="admin-eyebrow"><%= a('discounts') %></span><h1><%= a('productOffers') %></h1><p><%= a('offerPriceHint') %></p></div><a class="button button-secondary" href="/admin/catalog"><%= a('catalog') %></a></header>
  <% if (savedMessage) { %><p class="catalog-save-success" role="status" aria-live="polite"><%= a(savedMessage) %></p><% } %>
  <section class="workspace-panel admin-direct-offer" aria-labelledby="direct-offer-heading">
    <h2 id="direct-offer-heading"><%= a('addOfferToProduct') %></h2>
    <label class="admin-offer-search"><%= a('searchProducts') %><input type="search" data-offer-search autocomplete="off" placeholder="<%= a('offerSearchPlaceholder') %>" aria-describedby="offer-search-help"></label>
    <p id="offer-search-help" class="admin-offer-search-help"><%= a('offerSearchHelp') %></p>
    <p class="admin-product-search-empty" data-offer-search-empty hidden><%= a('noProductsFound') %></p>
    <div class="admin-offer-search-results" data-offer-search-results>
      <% for (const product of products) { const image = product.product_images?.[0]?.secure_url || product.image_url || '/assets/images/product-placeholder.svg'; const category = categories.find(item => item.id === product.category_id); const searchText = `${product.name || ''} ${product.name_ar || ''} ${category?.name || ''} ${category?.name_ar || ''}`.toLocaleLowerCase(); %>
        <article class="admin-offer-search-card" data-offer-search-card data-search-text="<%= searchText %>" hidden>
          <img src="<%= image %>" alt="" loading="lazy"><div class="admin-offer-search-info"><h3><%= locale === 'ar' ? product.name_ar : product.name %></h3><p><%= category ? (locale === 'ar' ? category.name_ar : category.name) : a('product') %> · <%= a('regularPrice') %>: EGP <%= product.price_egp %></p><% if (product.sale_price_egp != null) { %><p><%= a('currentOffer') %>: EGP <%= product.sale_price_egp %></p><% } %>
          <form action="/admin/promotions/products/<%= product.id %>/offer" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><%= a('offerPrice') %><input type="number" name="salePriceEgp" min="1" max="10000000" step="1" value="<%= product.sale_price_egp ?? '' %>" required></label><button class="button" type="submit"><%= a('saveOffer') %></button></form><%- include('color-offer-controls', { product }) %></div>
        </article>
      <% } %>
    </div>
  </section>
  <section class="admin-offer-list" aria-label="<%= a('productOffers') %>">
    <% if (!offerProducts.length) { %><p class="workspace-panel"><%= a('noProductOffers') %></p><% } else { %>
      <% for (const product of offerProducts) { const image = product.product_images?.[0]?.secure_url || product.image_url; %>
        <article class="admin-offer-card">
          <a class="admin-offer-image" href="/admin/catalog/products/<%= product.id %>/edit"><img src="<%= image || '/assets/images/product-placeholder.svg' %>" alt="" loading="lazy"></a>
          <div class="admin-offer-info"><h2><a href="/admin/catalog/products/<%= product.id %>/edit"><%= locale === 'ar' ? product.name_ar : product.name %></a></h2><p><del><%= a('regularPrice') %>: EGP <%= product.offer_regular_price_egp ?? product.price_egp %></del><strong>EGP <%= product.sale_price_egp %></strong></p><% for (const variant of product.offer_variants || []) { %><p class="admin-offer-variant"><%= locale === 'ar' ? variant.title_ar : variant.title %>: <del>EGP <%= variant.regular_price_egp %></del> <strong>EGP <%= variant.sale_price_egp %></strong></p><% } %><a class="text-link" href="/admin/catalog/products/<%= product.id %>/edit"><%= a('edit') %></a></div>
          <% if (product.offer_source === 'product') { %><form action="/admin/promotions/products/<%= product.id %>/remove" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-secondary" type="submit"><%= a('removeOffer') %></button></form><% } else { %><p class="admin-offer-campaign-note"><%= a(product.offer_source === 'variant' ? 'variantOfferManaged' : 'campaignOfferManagedBelow') %></p><% } %>
          <div class="admin-offer-color-controls"><%- include('color-offer-controls', { product }) %></div>
        </article>
      <% } %>
    <% } %>
  </section>
  <details class="workspace-panel admin-campaigns"><summary><%= a('campaignDiscounts') %></summary><p><%= a('discountHint') %></p>
    <form class="admin-form" action="/admin/promotions" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2><%= a('newDiscount') %></h2><%- include('bilingual-field', { prefix:'discount', key:'name', value:'', arValue:'', multiline:false, required:true }) %>
      <div class="admin-fields"><label><%= a('mode') %><select name="mode"><option value="PERCENT"><%= a('PERCENT') %></option><option value="FIXED"><%= a('FIXED') %></option></select></label><label><%= a('amount') %><input name="amount" type="number" min="1" step="1" max="1000000" required></label><label><%= a('scope') %><select name="scope" data-discount-scope><% for (const scope of ['ALL','PRODUCT','CATEGORY','TYPE','COLOR']) { %><option value="<%= scope %>"><%= a(scope) %></option><% } %></select></label></div>
      <input name="target" type="hidden" value="" data-scope-target="ALL"><fieldset class="admin-campaign-categories admin-campaign-products" data-scope-control="PRODUCT" hidden><legend><%= a('chooseProduct') %></legend><label class="admin-campaign-product-search"><%= a('searchProducts') %><input type="search" data-product-search autocomplete="off"></label><div class="admin-campaign-category-grid"><% for (const product of products) { const image = product.product_images?.[0]?.secure_url || product.image_url || '/assets/images/product-placeholder.svg'; const category = categories.find(item => item.id === product.category_id); const searchText = `${product.name || ''} ${product.name_ar || ''} ${category?.name || ''} ${category?.name_ar || ''}`.toLocaleLowerCase(); %><label class="admin-campaign-category-card admin-campaign-product-card" data-product-search-card data-search-text="<%= searchText %>"><input type="radio" name="target" value="<%= product.id %>" data-scope-target="PRODUCT" disabled required><img src="<%= image %>" alt="" loading="lazy"><span><strong><%= locale === 'ar' ? product.name_ar : product.name %></strong><small><%= category ? (locale === 'ar' ? category.name_ar : category.name) : a('product') %> · EGP <%= product.price_egp %></small></span></label><% } %></div><p class="admin-product-search-empty" data-product-search-empty hidden><%= a('noProductsFound') %></p></fieldset>
      <fieldset class="admin-campaign-categories" data-scope-control="CATEGORY" hidden><legend><%= a('chooseCollection') %></legend><div class="admin-campaign-category-grid"><% for (const category of categories) { const image = category.image_url || category.previewImage || '/assets/images/product-placeholder.svg'; %><label class="admin-campaign-category-card"><input type="radio" name="target" value="<%= category.id %>" data-scope-target="CATEGORY" disabled required><img src="<%= image %>" alt="" loading="lazy"><span><strong><%= locale === 'ar' ? category.name_ar : category.name %></strong><small><%= category.slug %></small></span></label><% } %></div></fieldset>
      <% for (const scope of ['TYPE','COLOR']) { %><label data-scope-control="<%= scope %>" hidden><%= a(scope) %><input name="target" list="<%= scope %>-values" data-scope-target="<%= scope %>" disabled maxlength="160"><datalist id="<%= scope %>-values"><% for (const detail of details) { const field=scope === 'TYPE' ? 'type_en' : 'color_en'; if (detail[field]) { %><option value="<%= detail[field] %>"></option><% } } %></datalist></label><% } %>
      <div class="admin-fields"><label><%= a('starts') %><input name="startsAt" value="<%= new Date().toISOString() %>" dir="ltr" required></label><label><%= a('ends') %><input name="endsAt" value="<%= new Date(Date.now()+7*86400000).toISOString() %>" dir="ltr" required></label></div><button class="button" type="submit"><%= a('add') %></button>
    </form>
    <div class="admin-records"><% for (const discount of discounts) { %><article class="workspace-panel"><h2><%= locale === 'ar' ? discount.name_ar : discount.name %></h2><p><%= a(discount.mode) %>: <%= discount.amount %> · <%= a(discount.scope) %> · <%= a(discount.is_active ? 'active' : 'inactive') %></p><% if(discount.is_active) { %><form action="/admin/promotions/<%= discount.id %>/disable" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-secondary" type="submit"><%= a('disable') %></button></form><% } %></article><% } %></div>
  </details>
</section>
