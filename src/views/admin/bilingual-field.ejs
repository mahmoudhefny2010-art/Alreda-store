<div class="admin-bilingual">
  <label><%= a(key) %><% if (multiline && key === 'description') { %><span class="rich-editor" data-rich-editor><span class="rich-editor-toolbar" role="toolbar" aria-label="<%= a('formatDescription') %>"><button type="button" data-command="bold" aria-label="<%= a('bold') %>"><strong>B</strong></button><button type="button" data-command="italic" aria-label="<%= a('italic') %>"><em>I</em></button><button type="button" data-command="insertUnorderedList" aria-label="<%= a('bulletList') %>">• List</button><button type="button" data-command="formatBlock" data-value="h3" aria-label="<%= a('heading') %>">H</button></span><div id="<%= prefix %>-<%= key %>-editor" class="rich-editor-surface" contenteditable="true" role="textbox" aria-multiline="true" lang="en" dir="ltr" data-rich-surface><%- sanitizeDescription(value || '') %></div><textarea class="rich-editor-value" id="<%= prefix %>-<%= key %>" name="<%= key %>" maxlength="8000" data-rich-value><%= value || '' %></textarea></span><% } else if (multiline) { %><textarea id="<%= prefix %>-<%= key %>" name="<%= key %>" lang="en" dir="ltr" maxlength="8000"><%= value || '' %></textarea><% } else { %><input id="<%= prefix %>-<%= key %>" name="<%= key %>" lang="en" dir="ltr" value="<%= value || '' %>" maxlength="<%= key === 'name' ? 120 : 100 %>" <%= required ? 'required' : '' %>><% } %></label>
  <label><%= a(key + 'Ar') %><% if (multiline && key === 'description') { %><span class="rich-editor" data-rich-editor><span class="rich-editor-toolbar" role="toolbar" aria-label="<%= a('formatDescription') %>"><button type="button" data-command="bold" aria-label="<%= a('bold') %>"><strong>B</strong></button><button type="button" data-command="italic" aria-label="<%= a('italic') %>"><em>I</em></button><button type="button" data-command="insertUnorderedList" aria-label="<%= a('bulletList') %>">• قائمة</button><button type="button" data-command="formatBlock" data-value="h3" aria-label="<%= a('heading') %>">H</button></span><div id="<%= prefix %>-<%= key %>-ar-editor" class="rich-editor-surface" contenteditable="true" role="textbox" aria-multiline="true" lang="ar" dir="rtl" data-rich-surface><%- sanitizeDescription(arValue || '') %></div><textarea class="rich-editor-value" id="<%= prefix %>-<%= key %>Ar" name="<%= key %>Ar" maxlength="10000" data-rich-value><%= arValue || '' %></textarea></span><% } else if (multiline) { %><textarea id="<%= prefix %>-<%= key %>-ar" name="<%= key %>Ar" lang="ar" dir="rtl" maxlength="10000"><%= arValue || '' %></textarea><% } else { %><input id="<%= prefix %>-<%= key %>-ar" name="<%= key %>Ar" lang="ar" dir="rtl" value="<%= arValue || '' %>" maxlength="160" <%= required ? 'required' : '' %>><% } %></label>
</div>
