<section class="admin-management"><h1><%= a('team') %></h1><p><%= a('accessHint') %></p>
<form class="workspace-panel admin-form" method="post" action="/admin/access"><h2><%= a('grant') %></h2><label><%= a('email') %><input type="email" name="email" maxlength="254" autocomplete="off" required></label><label><%= a('role') %><select name="role"><% for (const role of ['order_manager','catalog_manager','admin']) { %><option value="<%= role %>"><%= a(role) %></option><% } %></select></label><p><%= a('managerHint') %></p><button class="button" type="submit"><%= a('grant') %></button></form>
<div class="admin-records"><% for (const grant of grants) { %><article class="workspace-panel"><h2><bdi><%= grant.email %></bdi></h2><p><%= a(grant.role) %> · <%= a(grant.is_active ? 'active' : 'inactive') %></p><% if (grant.is_active) { %><form action="/admin/access/<%= grant.id %>/revoke" method="post"><button class="button" type="submit"><%= a('revoke') %></button></form><% } %></article><% } %></div></section>
