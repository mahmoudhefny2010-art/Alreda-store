<% const text = (en, ar) => locale === 'ar' ? ar : en; const fields = [['titleEn', 'Title (English)', 'العنوان بالإنجليزية', 'en', 100], ['titleAr', 'Title (Arabic)', 'العنوان بالعربية', 'ar', 100], ['bodyEn', 'Message (English)', 'الرسالة بالإنجليزية', 'en', 500], ['bodyAr', 'Message (Arabic)', 'الرسالة بالعربية', 'ar', 500]]; %>
<div class="admin-bilingual"><% for (const [key, en, ar, language, limit] of fields) { %><label><%= text(en, ar) %><% if (key.startsWith('body')) { %><textarea data-message-field="<%= key %>" lang="<%= language %>" dir="<%= language === 'ar' ? 'rtl' : 'ltr' %>" maxlength="<%= limit %>" required><%= message[key] || '' %></textarea><% } else { %><input data-message-field="<%= key %>" value="<%= message[key] || '' %>" lang="<%= language %>" dir="<%= language === 'ar' ? 'rtl' : 'ltr' %>" maxlength="<%= limit %>" required><% } %></label><% } %></div>
<label><%= text('Open this store page when clicked', 'الصفحة التي تُفتح عند الضغط') %><input data-message-field="url" value="<%= message.url || '/' %>" maxlength="500" pattern="/.*" dir="ltr" required><small><%= text('Use a local path such as /products or /collections/mirrors.', 'استخدم رابطًا داخليًا مثل /products أو /collections/mirrors.') %></small></label>
<aside class="push-preview" aria-label="<%= text('Notification preview', 'معاينة الإشعار') %>"><small>ALREDA STORE · <%= text('Preview', 'معاينة') %></small><strong data-push-preview-title></strong><p data-push-preview-body></p></aside>
