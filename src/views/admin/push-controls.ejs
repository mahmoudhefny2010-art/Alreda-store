<% const text = (en, ar) => locale === 'ar' ? ar : en; %>
<section class="store-operations">
  <% if (queuedCampaign) { %><p class="operations-success" role="status"><%= text(`Queued for ${queuedCampaign.count} eligible customers. Check delivery history below; queued does not mean delivered.`, `تمت إضافة الرسالة لقائمة الإرسال إلى ${queuedCampaign.count} عميل مؤهل. راجع سجل الإرسال أدناه؛ إضافة الرسالة للقائمة لا تعني وصولها.`) %></p><% } %>
  <% if (templateSaved) { %><p class="operations-success" role="status"><%= text('Automatic notification template saved.', 'تم حفظ قالب الإشعار التلقائي.') %></p><% } %>
  <% if (!pushEnabled) { %><p class="operations-notice"><%= text('Sending is unavailable until OneSignal is configured on the server. You can still edit automatic templates.', 'الإرسال غير متاح حتى يتم إعداد OneSignal على السيرفر. يمكنك تعديل القوالب التلقائية الآن.') %></p><% } %>
  <form class="workspace-panel admin-form" method="post" action="/admin/notifications/campaigns" data-campaign-form data-push-ready="<%= pushEnabled ? 'true' : 'false' %>" data-request-key="<%= requestKey %>" data-locale="<%= locale %>">
    <h2><%= text('Write a push notification', 'كتابة إشعار للعملاء') %></h2>
    <p class="operations-hint"><%= text('Only active, signed-in customers who enabled marketing notifications and registered a device are eligible. Customer preferences are checked again before delivery.', 'تُرسل فقط للعملاء المسجلين النشطين الذين وافقوا على إشعارات العروض وسجلوا جهازًا. تُراجع الموافقة مجددًا قبل الإرسال.') %></p>
    <input type="hidden" name="configuration" data-operation-configuration>
    <div class="admin-fields"><label><%= text('Recipients', 'المستلمون') %><select data-push-audience><% for (const [key, en, ar] of [['ALL','All consenting subscribers','كل المشتركين الموافقين'],['ACTIVE_CART','Customers with an active cart','العملاء الذين لديهم سلة نشطة'],['CUSTOMERS_WITH_ORDERS','Customers with previous orders','العملاء الذين لديهم طلبات سابقة']]) { %><option value="<%= key %>" data-recipient-count="<%= audienceCounts[key] || 0 %>"><%= text(en, ar) %> (<%= audienceCounts[key] || 0 %>)</option><% } %></select></label><label><%= text('Message idea', 'فكرة الرسالة') %><select data-push-preset><option value="CUSTOM"><%= text('Write my own message', 'كتابة رسالة خاصة') %></option><option value="OFFER"><%= text('Offer or discount', 'عرض أو خصم') %></option><option value="NEW"><%= text('New products', 'منتجات جديدة') %></option></select></label></div>
    <p class="operations-hint" data-audience-note role="status" aria-live="polite"></p>
    <%- include('push-editor', { message: { titleEn:'', titleAr:'', bodyEn:'', bodyAr:'', url:'/products' } }) %>
    <div class="operations-actions"><button type="submit" class="button" <%= pushEnabled ? '' : 'disabled' %>><%= text('Review recipients and message', 'مراجعة المستلمين والرسالة') %></button></div>
    <dialog class="push-review" data-push-review><h3><%= text('Review before sending', 'مراجعة قبل الإرسال') %></h3><p data-review-audience></p><strong data-review-title></strong><p data-review-body></p><p class="operations-hint"><%= text('This queues a real push notification for the selected eligible audience.', 'سيتم إدراج إشعار حقيقي للإرسال إلى الجمهور المؤهل الذي اخترته.') %></p><div class="operations-actions"><button type="button" class="button button-secondary" data-cancel-push><%= text('Back to editing', 'العودة للتعديل') %></button><button type="button" class="button" data-confirm-push><%= text('Queue notification', 'إدراج الإشعار للإرسال') %></button></div></dialog>
  </form>
  <section class="operations-templates"><h2><%= text('Automatic notification messages', 'رسائل الإشعارات التلقائية') %></h2><p class="operations-hint"><%= text('Choose an event, enable or disable it, and write the message customers receive. Saving a template does not send a campaign.', 'اختر الحدث، فعّله أو أوقفه، واكتب الرسالة التي تصل للعميل. حفظ القالب لا يُرسل حملة.') %></p>
  <% for (const template of templates) { const names = { ORDER_PLACED: ['Order received','استلام الطلب'], ORDER_STATUS:['Order status changed','تغيير حالة الطلب'], ABANDONED_CART:['Abandoned cart reminder','تذكير بالسلة المتروكة'] }; %>
    <details class="workspace-panel"><summary><%= text(...names[template.eventType]) %></summary><form class="admin-form" action="/admin/notifications/templates" method="post" data-template-form data-event-type="<%= template.eventType %>" data-locale="<%= locale %>"><input type="hidden" name="configuration" data-operation-configuration><label class="admin-check"><input type="checkbox" data-template-enabled <%= template.enabled ? 'checked' : '' %>><%= text('Enable this notification', 'تفعيل هذا الإشعار') %></label><%- include('push-editor', { message: template.message }) %><p class="operations-hint"><%= text('Use {reference} for the order number and {status} for the translated order status. Customers must allow the corresponding notification category.', 'استخدم {reference} لرقم الطلب و{status} لحالة الطلب المترجمة. يجب أن يوافق العميل على نوع الإشعار المناسب.') %></p><button class="button" type="submit"><%= text('Save this template', 'حفظ هذا القالب') %></button></form></details>
  <% } %></section>
</section>
<script src="/assets/js/admin-store-operations.js?v=operations-20261103-1" defer></script>
