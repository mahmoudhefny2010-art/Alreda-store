<section class="shopping-hero" aria-labelledby="hero-title">
  <img class="shopping-hero-image" src="<%= typeof mediaAsset === 'function' ? mediaAsset('banner:homepage', '/assets/images/bathroom-hero.jpg', 'homepage-banner') : '/assets/images/bathroom-hero.jpg' %>" alt="<%= t('heroAlt') %>" width="736" height="736" fetchpriority="high">
  <div class="shopping-hero-content"><h1 id="hero-title"><%= t('hero') %></h1><a class="hero-shop-button" href="#collections"><%= t('shopAll') %></a></div>
</section>
<% collectionGroups.forEach(group => { %>
<section id="<%= group.id %>" class="container collections-section collections-section--<%= group.type %>" aria-labelledby="<%= group.titleId %>">
  <h2 id="<%= group.titleId %>"><%= group.title %></h2>
  <div class="category-grid category-grid--<%= group.type %>"><% group.categories.forEach(category => { %><%- include('../partials/category-card', { category }) %><% }); %></div>
</section>
<% }); %>
<div class="container catalog-all-link"><a class="button" href="/products"><%= t('browseAll') %></a></div>

