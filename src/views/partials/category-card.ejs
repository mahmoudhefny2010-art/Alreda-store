<article class="category-card" data-category-name="<%= category.name %>">
  <a href="<%= category.href %>" class="category-link">
    <span class="category-media">
      <% if (category.image) { %><img class="category-image" src="<%= category.image %>" alt="<%= category.name %>" width="640" height="640" loading="lazy">
      <% } else { %><span class="category-image image-placeholder" role="img" aria-label="<%= t('imageUnavailable') %>: <%= category.name %>"><span><%= t('imageUnavailable') %></span></span><% } %>
    </span>
    <h3><span><%= category.name %></span><%- include('icon', { name: 'arrow' }) %></h3>
  </a>
</article>
