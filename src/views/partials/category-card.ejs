<article class="category-card" data-category-name="<%= category.name %>">
  <a href="<%= category.href %>" class="category-link">
    <span class="category-media">
      <% if (category.image) { const categoryImageSmall = category.image.includes('res.cloudinary.com') ? category.image.replace(/w_640(?=\/)/, 'w_360') : category.image; %><img class="category-image" src="<%= category.image %>" srcset="<%= categoryImageSmall %> 360w, <%= category.image %> 640w" sizes="(max-width: 600px) calc((100vw - 52px) / 2), (max-width: 1100px) calc((100vw - 96px) / 4), 280px" alt="<%= category.name %>" width="640" height="640" loading="lazy">
      <% } else { %><span class="category-image image-placeholder" role="img" aria-label="<%= t('imageUnavailable') %>: <%= category.name %>"><span><%= t('imageUnavailable') %></span></span><% } %>
    </span>
    <h3><span><%= category.name %></span><%- include('icon', { name: 'arrow' }) %></h3>
  </a>
</article>
