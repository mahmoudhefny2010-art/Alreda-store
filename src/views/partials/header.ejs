<header class="shop-header">
  <div class="container header-top">
    <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="<%= t('menu') %>"><span class="menu-icon" aria-hidden="true"></span></button>
    <div class="navigation-row">
      <nav id="site-nav" class="site-nav" aria-label="<%= t('mainNavigation') %>"><a href="/" <% if (title === t('collectionsTitle')) { %>aria-current="page"<% } %>><%= t('home') %></a><a href="/#collections" <% if (typeof category !== 'undefined') { %>class="is-active"<% } %>><%= t('catalog') %></a><a href="/#contact"><%= t('contact') %></a><a href="/#about-us"><%= t('about') %></a></nav>
    </div>
    <a class="shop-brand" href="/" aria-label="<%= t('storeName') %>"><img src="<%= typeof mediaAsset === 'function' ? mediaAsset('branding:logo', '/assets/images/alreda-delight-logo.jpg', 'thumbnail') : '/assets/images/alreda-delight-logo.jpg' %>" alt="<%= t('brandAlt') %>" width="110" height="110"></a>
    <div class="header-actions">
      <form class="language-control" action="/language" method="post"><input type="hidden" name="returnTo" value="<%= returnTo %>"><label class="sr-only" for="store-language"><%= t('language') %></label><select id="store-language" name="locale" aria-label="<%= t('language') %>"><option value="en" <%= locale === 'en' ? 'selected' : '' %>>English</option><option value="ar" <%= locale === 'ar' ? 'selected' : '' %>>العربية</option></select><noscript><button type="submit"><%= t('apply') %></button></noscript></form>
      <button class="icon-button" type="button" data-dialog="search-dialog" aria-label="<%= t('search') %>"><%- include('icon', { name: 'search' }) %></button>
      <a class="icon-button wishlist-header-toggle" href="/wishlist" aria-label="<%= t('favorites') %>" <%= returnTo.startsWith('/wishlist') ? 'aria-current="page"' : '' %>><%- include('icon', { name: 'heart' }) %><span class="bag-count" data-wishlist-count hidden aria-hidden="true"></span></a>
      <button class="icon-button" type="button" data-dialog="account-dialog" aria-label="<%= t('account') %>"><%- include('icon', { name: 'account' }) %></button>
      <button class="icon-button bag-toggle" type="button" data-dialog="bag-dialog" aria-label="<%= t('bag') %>" data-bag-label="<%= t('bag') %>"><%- include('icon', { name: 'bag' }) %><span class="bag-count" data-cart-count hidden aria-hidden="true"></span></button>
    </div>
  </div>
</header>
<dialog id="search-dialog" class="shop-dialog" aria-labelledby="search-title" data-found-text="<%= t('collectionsFound') %>" data-empty-text="<%= t('noMatches') %>">
  <form method="dialog" class="dialog-top"><h2 id="search-title"><%= t('searchCollections') %></h2><button class="icon-button" aria-label="<%= t('close') %>">×</button></form>
  <label class="search-label" for="collection-search"><%= t('findCollection') %></label>
  <input id="collection-search" type="search" placeholder="<%= t('searchPlaceholder') %>" autocomplete="off">
  <p id="search-status" role="status"></p><ul id="search-results"><% if (typeof categories !== 'undefined') { categories.forEach(item => { %><li><a href="<%= item.href %>"><%= item.name %></a></li><% }); } %></ul>
</dialog>
<dialog id="account-dialog" class="shop-dialog account-dialog" aria-labelledby="account-title"><form method="dialog" class="dialog-top"><h2 id="account-title"><%= t('account') %></h2><button class="icon-button" aria-label="<%= t('close') %>">×</button></form>
  <% if (typeof customer !== 'undefined' && customer) { %><div class="account-identity"><span class="account-avatar" aria-hidden="true"><%- include('icon', { name: 'account' }) %></span><div><p><%= t('signedInAs') %></p><strong><%= customer.name %></strong><% if (!customer.google_id) { %><a class="text-link account-link" href="/auth/google/link"><%= t('linkGoogle') %></a><% } %></div></div>
    <% if (customer.role === 'admin' || (Array.isArray(customer.user_roles) && customer.user_roles.some(entry => entry.role === 'admin')) || (Array.isArray(customer.admin_permissions) && customer.admin_permissions.length)) { %>
      <div class="account-workspace"><span class="account-role"><%= t('accountAdminRole') %></span><a class="button account-workspace-link" href="/admin"><%= t('accountOpenAdmin') %><span aria-hidden="true">↗</span></a></div>
    <% } %>
    <div class="account-workspace"><a class="button account-workspace-link" href="/account/orders"><%= locale === 'ar' ? 'طلباتي' : 'My orders' %><span aria-hidden="true">→</span></a></div>
    <% if (typeof onesignalAppId !== 'undefined' && onesignalAppId) { %><form class="notification-preferences" data-notification-preferences>
      <fieldset class="account-preferences"><legend><%= t('notificationsLabel') %></legend>
        <label class="account-preference"><span><%= t('notificationsTransactional') %></span><input type="checkbox" name="transactional" <%= notificationPreferences?.transactional_enabled !== false ? 'checked' : '' %>></label>
        <label class="account-preference"><span><%= t('notificationsMarketing') %></span><input type="checkbox" name="marketing" <%= notificationPreferences?.marketing_enabled ? 'checked' : '' %>></label>
      </fieldset>
      <div class="account-actions"><button class="button account-enable" type="button" data-enable-notifications><%= t('enablePush') %></button><button class="button" type="button" data-test-notifications hidden><%= t('pushTest') %></button></div><p class="account-notification-status" data-notification-status role="status" aria-live="polite"></p>
    </form><% } %>
    <form class="account-logout" action="/auth/logout" method="post" data-sign-out><input type="hidden" name="_csrf" value="<%= logoutCsrfToken %>"><button class="button" type="submit"><%= t('signOut') %></button></form>
  <% } else if (typeof googleAuthEnabled !== 'undefined' && googleAuthEnabled) { %><a class="button google-sign-in" href="/auth/google"><%= t('continueWithGoogle') %></a>
  <% } else { %><p><%= t('googleAuthUnavailable') %></p><% } %>
</dialog>
<dialog id="bag-dialog" class="shop-dialog" aria-labelledby="bag-title" data-cart-dialog data-empty-text="<%= t('bagEmpty') %>" data-remove-text="<%= t('cartRemove') %>" data-total-text="<%= t('cartTotal') %>" data-error-text="<%= t('cartError') %>" data-added-text="<%= t('cartAdded') %>" data-unavailable-text="<%= t('cartUnavailable') %>" data-out-of-stock-text="<%= t('cartOutOfStock') %>" data-stock-warning-text="<%= t('cartQuantityChanged') %>"><form method="dialog" class="dialog-top"><h2 id="bag-title"><%= t('bag') %></h2><button class="icon-button" aria-label="<%= t('close') %>">×</button></form>
  <p class="bag-status" data-cart-status role="status"></p><ul class="bag-items" data-cart-items></ul><p class="bag-total" data-cart-total></p>
  <div class="bag-actions"><a class="button" href="/checkout" data-cart-checkout><%= typeof customer !== 'undefined' && customer ? t('checkoutTitle') : t('continueWithGoogle') %></a>
  <a class="text-link" href="/#collections"><%= t('browseCollections') %></a></div>
</dialog>
<div class="cart-feedback" data-cart-feedback role="status" aria-live="polite" aria-atomic="true" hidden><span class="cart-feedback-check" aria-hidden="true">✓</span><span data-cart-feedback-text></span></div>
