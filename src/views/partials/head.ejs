<% const assetHref = typeof assetUrl === 'function' ? assetUrl : value => value; %>
<!doctype html>
<html lang="<%= locale %>" dir="<%= direction %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <meta name="description" content="<%= t('bathroomHome') %> â€” <%= t('collectionsTitle') %>">
  <meta name="color-scheme" content="light">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#51352f">
  <link rel="apple-touch-icon" href="/assets/images/pwa/icon-192.png">
  <link rel="icon" type="image/jpeg" href="<%= typeof mediaAsset === 'function' ? mediaAsset('branding:logo', '/assets/images/alreda-delight-logo.jpg', 'thumbnail') : '/assets/images/alreda-delight-logo.jpg' %>">
  <title><%= title %> | <%= t('storeName') %></title>
  <% if (typeof mediaCloudName !== 'undefined' && mediaCloudName) { %><link rel="preconnect" href="https://res.cloudinary.com"><% } %>
  <% if (contentView === '../storefront/home') { const mobileHero = typeof mediaAsset === 'function' ? mediaAsset('banner:homepage', '/assets/images/bathroom-hero.jpg', 'mobile-banner') : '/assets/images/bathroom-hero.jpg'; %>
  <link rel="preload" as="image" href="<%= mobileHero %>" media="(max-width: 760px)" fetchpriority="high">
  <% } %>
  <link rel="stylesheet" href="<%= assetHref('/assets/css/base/variables.css') %>">
  <link rel="stylesheet" href="<%= assetHref('/assets/css/pages/storefront.css') %>">
  <link rel="stylesheet" href="<%= assetHref('/assets/css/components/wishlist-navigation.css') %>">
  <link rel="stylesheet" href="<%= assetHref('/assets/css/main.css') %>">
  <% if (typeof adminPath !== 'undefined' && adminPath.startsWith('/admin')) { %>
  <link rel="stylesheet" href="<%= assetHref('/assets/css/pages/admin-workspace.css') %>">
  <link rel="stylesheet" href="<%= assetHref('/assets/css/pages/admin-management.css') %>">
  <link rel="stylesheet" href="<%= assetHref('/assets/css/pages/admin-catalog.css') %>">
  <link rel="stylesheet" href="<%= assetHref('/assets/css/pages/admin-variant-editor.css') %>">
  <link rel="stylesheet" href="<%= assetHref('/assets/css/pages/admin-operations.css') %>">
  <link rel="stylesheet" href="<%= assetHref('/assets/css/pages/orders-admin.css') %>">
  <link rel="stylesheet" href="<%= assetHref('/assets/css/pages/homepage-layout.css') %>">
  <% } %>
  <link rel="stylesheet" href="<%= assetHref('/assets/css/components/whatsapp-button.css') %>">
  <% if (typeof product !== 'undefined' && product) { %><link rel="stylesheet" href="<%= assetHref('/assets/css/pages/product-details.css') %>"><% } %>
  <link rel="stylesheet" href="<%= assetHref('/assets/css/components/visit-ui.css') %>">
  <script src="<%= assetHref('/assets/js/page-loading.js') %>"></script>
  <script src="<%= assetHref('/assets/js/main.js') %>" defer></script>
  <script src="/assets/js/vercel-analytics-bootstrap.js?v=csp-20261104-1" defer></script>
  <script defer src="/_vercel/insights/script.js"></script>
  <link rel="stylesheet" href="<%= assetHref('/assets/css/components/cart.css') %>">
  <% if (typeof adminPath !== 'undefined' && adminPath.startsWith('/admin/catalog')) { %><script src="/assets/js/admin-catalog.js?v=color-offers-20261103-2" defer></script><script src="/assets/js/admin-presentation.js?v=type-prices-20261103-1" defer></script><script src="/assets/js/admin-variant-editor.js?v=variant-matrix-20261103-1" defer></script><script src="/assets/js/admin-translation.js?v=product-options-20261103-1" defer></script><% } %>
  <% if (typeof adminPath !== 'undefined' && adminPath.startsWith('/admin/promotions')) { %><script src="/assets/js/admin-management.js?v=direct-offer-search-20261103-1" defer></script><script src="/assets/js/admin-translation.js?v=discount-translation-20261103-1" defer></script><% } %>
  <% if (typeof adminPermissions !== 'undefined' && adminPermissions.includes('orders')) { %><script src="/assets/js/admin-order-alerts.js?v=new-orders-20261105-1" defer></script><% } %>
  <script src="/assets/js/scroll-reveal.js" defer></script>
  <% if (typeof onesignalAppId !== 'undefined' && onesignalAppId && typeof customer !== 'undefined' && customer) { %><script src="/assets/js/onesignal-client.js?v=push-recovery-20261105-1" defer data-app-id="<%= onesignalAppId %>" data-user-id="<%= customer.id %>" data-saved-label="<%= t('notificationsSaved') %>" data-error-label="<%= t('notificationsSaveError') %>" data-test-sent-label="<%= t('pushTestSent') %>" data-test-error-label="<%= t('pushTestError') %>" data-sdk-error-label="<%= t('pushSdkError') %>" data-account-error-label="<%= t('pushAccountError') %>" data-device-error-label="<%= t('pushDeviceError') %>" data-subscription-error-label="<%= t('pushSubscriptionError') %>" data-ready-label="<%= t('pushReady') %>"></script><% } %>
</head>
