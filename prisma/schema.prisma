  id                                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  google_id                               String?            @unique(map: "users_google_id_uq", where: raw("(google_id IS NOT NULL)")) @db.VarChar(160)
  email                                   String             @unique(map: "users_email_unique") @db.VarChar(254)
  name                                    String             @db.VarChar(160)
  phone                                   String?            @db.VarChar(24)
  role                                    String             @default("customer") @db.VarChar(24)
  is_active                               Boolean            @default(true)
  created_at                              DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime           @default(now()) @db.Timestamptz(6)
  addresses                               addresses[]
  driver_locations                        driver_locations[]
  order_events                            order_events[]
  order_requests                          order_requests[]
  orders_orders_assigned_driver_idTousers orders[]           @relation("orders_assigned_driver_idTousers")
  orders_orders_paid_byTousers            orders[]           @relation("orders_paid_byTousers")
  orders_orders_user_idTousers            orders[]           @relation("orders_user_idTousers")
  push_subscribers                        push_subscribers[]
  site_page_views                         site_page_views[]
  site_visitors                           site_visitors[]
  user_roles                              user_roles[]
  customer_sessions                       customer_sessions[]
  shopping_carts                          shopping_carts[]
  notification_preferences                notification_preferences?
  notification_outbox                     notification_outbox[]
  cart_reminders                          cart_reminders[]
  customer_favorites                      customer_favorites[]

  @@index([role, is_active], map: "users_role_active_idx")
}

model customer_favorites {
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, product_id], map: "customer_favorites_pk")
  @@index([user_id, created_at], map: "customer_favorites_user_created_idx")
}

model payment_proofs {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  order_id           String?   @unique @db.Uuid
  public_id          String    @unique @db.VarChar(240)
  content_hash       String    @unique @db.VarChar(64)
  format             String    @default("png") @db.VarChar(8)
  status             String    @default("UPLOADED") @db.VarChar(16)
  transfer_reference String?   @unique @db.VarChar(120)
  reviewed_by        String?   @db.Uuid
  reviewed_at        DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  expires_at         DateTime  @db.Timestamptz(6)
  orders             orders?   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  owner              users     @relation("proof_owner", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewer           users?    @relation("proof_reviewer", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([user_id, created_at], map: "payment_proofs_owner_created_idx")
}

model customer_sessions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token_hash String   @unique(map: "customer_sessions_token_hash_uq") @db.VarChar(64)
  user_id    String   @db.Uuid
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, expires_at], map: "customer_sessions_user_expiry_idx")
  @@index([expires_at], map: "customer_sessions_expiry_idx")
}

model shopping_carts {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?     @db.Uuid
  guest_token_hash String?    @unique(map: "shopping_carts_guest_token_hash_uq") @db.VarChar(64)
  status          String      @default("ACTIVE") @db.VarChar(16)
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @default(now()) @db.Timestamptz(6)
  users           users?      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cart_items      cart_items[]
  cart_reminder   cart_reminders?

  @@index([user_id, status, updated_at], map: "shopping_carts_user_status_updated_idx")
  @@index([status, updated_at], map: "shopping_carts_status_updated_idx")
}

model cart_items {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cart_id    String        @db.Uuid
  product_id String        @db.Uuid
  variant_id String?       @db.Uuid
  quantity   Int
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  updated_at DateTime      @default(now()) @db.Timestamptz(6)
  carts      shopping_carts @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products   products       @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "cart_items_variant_id_foreign")

  @@index([cart_id, product_id, variant_id], map: "cart_items_cart_product_variant_idx")
  @@index([product_id], map: "cart_items_product_idx")
}

model notification_preferences {
  user_id                    String   @id @db.Uuid
  transactional_enabled      Boolean  @default(true)
  marketing_enabled           Boolean  @default(false)
  updated_at                 DateTime @default(now()) @db.Timestamptz(6)
  users                      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model notification_outbox {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @db.Uuid
  order_id         String?  @db.Uuid
  reminder_id      String?  @unique(map: "notification_outbox_reminder_uq") @db.Uuid
  event_type       String   @db.VarChar(40)
  dedupe_key       String   @unique(map: "notification_outbox_dedupe_uq") @db.VarChar(200)
  payload          Json
  status           String   @default("PENDING") @db.VarChar(16)
  attempts         Int      @default(0)
  locked_until     DateTime? @db.Timestamptz(6)
  available_at     DateTime @default(now()) @db.Timestamptz(6)
  sent_at          DateTime? @db.Timestamptz(6)
  last_error_code  String   @default("") @db.VarChar(64)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  users            users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reminders        cart_reminders? @relation(fields: [reminder_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  attempts_log     notification_attempts[]

  @@index([status, available_at, created_at], map: "notification_outbox_pending_idx")
  @@index([user_id, created_at], map: "notification_outbox_user_created_idx")
}

model notification_attempts {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outbox_id         String   @db.Uuid
  status            String   @db.VarChar(16)
  provider_message_id String @default("") @db.VarChar(160)
  error_code        String   @default("") @db.VarChar(64)
  attempted_at      DateTime @default(now()) @db.Timestamptz(6)
  outbox            notification_outbox @relation(fields: [outbox_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([outbox_id, attempted_at], map: "notification_attempts_outbox_time_idx")
}

model cart_reminders {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cart_id      String   @unique(map: "cart_reminders_cart_uq") @db.Uuid
  user_id      String   @db.Uuid
  status       String   @default("SCHEDULED") @db.VarChar(16)
  run_after    DateTime @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  carts        shopping_carts @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notification_outbox notification_outbox?

  @@index([status, run_after], map: "cart_reminders_due_idx")
}



