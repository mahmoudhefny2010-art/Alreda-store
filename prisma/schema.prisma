  currency          String   @db.VarChar(3)
  verified_at       DateTime @default(now()) @db.Timestamptz(6)
  orders            orders   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([provider, event_id])
  @@unique([provider, payment_reference])
}

model push_subscribers {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                   String   @db.Uuid
  external_id               String   @db.VarChar(80)
  onesignal_subscription_id String   @unique(map: "push_subscribers_onesignal_subscription_id_unique") @db.VarChar(120)
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  users                     users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "push_subscribers_user_id_foreign")

  @@unique([user_id, onesignal_subscription_id], map: "push_subscribers_user_subscription_uq")
  @@index([user_id], map: "push_subscribers_user_idx")
}

model site_copy {
